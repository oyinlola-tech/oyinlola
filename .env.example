# Contact form delivery (Resend). Without these the form degrades to showing
# the email address instead of pretending a message was sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="Portfolio <contact@oyinlola.site>"

# Where messages land. Defaults to site.email if unset.
CONTACT_TO_EMAIL=oluwayemioyinlola2@gmail.com

# Google Search Console verification token (the HTML-tag method). Optional —
# only needed until the property is verified, and harmless to leave set.
GOOGLE_SITE_VERIFICATION=
